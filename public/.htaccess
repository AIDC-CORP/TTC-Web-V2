# =============================================
# TTC Web V2 - Apache Configuration
# =============================================

# ----- SPA Routing (React Router) -----
# Redirect tất cả request về index.html để React Router xử lý
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Không rewrite nếu là file hoặc thư mục thật sự tồn tại
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Redirect tất cả về index.html
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# ----- Nén Gzip -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE text/xml
</IfModule>

# ----- Cache trình duyệt -----
<IfModule mod_expires.c>
  ExpiresActive On

  # File JS/CSS có hash trong tên -> cache lâu (1 năm)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Hình ảnh -> cache 1 tháng
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"

  # Font -> cache 1 năm
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # HTML -> không cache (luôn lấy bản mới nhất)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ----- Bảo mật cơ bản -----
# Chặn truy cập trực tiếp vào file .env, .git, ...
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Chặn liệt kê thư mục
Options -Indexes

# ----- HTTP Headers cho SEO và bảo mật -----
<IfModule mod_headers.c>
  # Bảo mật: Chống clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Bảo mật: Chống MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Bảo mật: XSS Protection
  Header always set X-XSS-Protection "1; mode=block"

  # SEO: Đảm bảo canonical đúng (tránh www vs non-www duplicate)
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Cache: File có hash -> cache lâu, không cần revalidate
  <FilesMatch "\.[a-f0-9]{8}\.(js|css|png|jpg|jpeg|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cache: HTML luôn revalidate để nhận bản mới nhất
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
